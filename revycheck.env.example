# Configuração do agente RevyCheck.
#
# Copie para `revycheck.env` ao lado do executável (ou na raiz do repo, em
# desenvolvimento) e preencha. Este arquivo é versionado — nunca coloque
# valores reais aqui.
#
# Variável de ambiente tem precedência sobre o arquivo.
#
# Por que arquivo e não compilado: o agente é distribuído como binário para as
# bancadas, e binário distribuído acaba lido. Chave em arquivo se rotaciona
# editando um arquivo no compartilhamento; chave compilada exige rebuild e
# republicação em toda bancada.

# --- API ---
# A chave abre só /revy-check/* e é separada da chave mestra da API Revy.
# Vem de REVYCHECK_API_KEY no .env de apps/api.
REVYCHECK_API_URL=http://revy.selbetti.com.br:8000/revy-check
REVYCHECK_API_KEY=
REVYCHECK_API_TIMEOUT=15

# --- Modo DEV ---
# Vazio desabilita o modo DEV. Sem isso preenchido, a hotkey
# Ctrl+Shift+D+V não destrava nada — que é o que se quer numa bancada de
# produção, onde DEV permite aprovar teste na mão.
REVYCHECK_DEV_PASSWORD=

# --- SMB (fotos da câmera) ---
# Vazio desliga o envio: o teste de câmera continua rodando, só não sobe a foto.
REVYCHECK_SMB_HOST=
REVYCHECK_SMB_SHARE=
REVYCHECK_SMB_USER=
REVYCHECK_SMB_PASSWORD=
REVYCHECK_SMB_PATH=
